cat << 'EOF' > /home/userverna/MyGames/.gitignore
__pycache__/
env/
venv/
.env
.env.*
*.pyc
.vscode/
.idea/ # <- se um dia usar PyCharm

# Pasta de utilitários e scripts (Não enviar para o GitHub)
scripts/
DOCS/

# Arquivos de dados e scripts de carga
*.xlsx
*.csv
*.txt
*.sql
!schema.sql
!requirements.txt
!carga_configs.sql

# Arquivos de log
*.log

# Arquivos temporários e uploads locais
*:Zone.Identifier
static/uploads/
flask_session/
instance/ # <- Flask cria essa pasta se usar sqlite em app.instance_path
utils/run_etl_docker.sh
EOF

cd /home/userverna/MyGames
git add .gitignore
git commit -m "chore: corrige regra *.log no .gitignore"
git push origin main